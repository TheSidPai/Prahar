<?xml version="1.0" encoding="utf-8"?>
<!--
  Matches the launcher icon's palette so the widget reads as belonging to
  Prahar without needing the app name. Rounded corners hug most Android
  launcher shapes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#292E60"
        android:endColor="#584AB0"/>
    <corners android:radius="24dp"/>
</shape>
