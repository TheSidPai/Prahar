<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 30 minutes; the app also pushes updates via broadcast
  whenever the plan changes or a block ticks over, so the periodic refresh is
  a safety net rather than the primary path. Android clamps this to 30 min
  minimum anyway.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_next_block"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/widget_next_block"
    android:description="@string/widget_description"/>
