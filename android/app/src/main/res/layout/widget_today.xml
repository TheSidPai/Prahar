<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept intentionally minimal after "Can't load widget" on MIUI: LinearLayout
  and TextView, and nothing else. No ProgressBar, no nested weight layouts, no
  ?android:attr references — and, since 5 Sep, no bare <View> either, which is
  what was still breaking it. Progress is drawn as text, because a real bar
  needs either a ProgressBar or a runtime width change RemoteViews only offers
  from API 31.

  The rule that actually matters: RemoteViews accepts only classes marked
  @RemoteView. If a view type is not in that set the whole layout fails to
  inflate with one generic message and no line number, so adding any new view
  type here is a gamble that has to be tested on the device.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/today_block1_subject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textColor="#B8B4C8"
        android:includeFontPadding="false"
        android:text=""/>

    <TextView
        android:id="@+id/today_block1_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#F5F4FC"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/today_block1_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="#B8B4C8"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:text=""/>

    <!--
      A TextView, not a View, and that is the whole point of this element.
      RemoteViews inflates through a filter that only accepts classes marked
      @RemoteView, and android.view.View is not one of them — so a bare <View>
      divider takes the entire layout down with a generic "Can't load widget"
      and no clue which line caused it. The widget that works has no <View> in
      it; this one did, and that was the only structural difference between
      them. An empty TextView with a background draws an identical hairline
      from a class that is on the list.
    -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="false"
        android:background="#33FFFFFF"
        android:text=""/>

    <TextView
        android:id="@+id/today_block2_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#E4E1F0"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/today_block2_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#8E88A6"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:text=""/>

    <!-- Progress rendered as text. A visual bar needs either a ProgressBar
         (drawable references fail on stripped-down inflaters) or a runtime
         width change on a View (RemoteViews only offers that from API 31).
         Text works on everything and is at least as informative. -->
    <TextView
        android:id="@+id/today_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textColor="#FAB074"
        android:includeFontPadding="false"
        android:text=""/>
</LinearLayout>
