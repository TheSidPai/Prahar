<?xml version="1.0" encoding="utf-8"?>
<!--
  The "today" tile. Two blocks (next + the one after that) stacked above a
  thin progress bar. Fixed row heights so nothing clips — a lesson from the
  first widget, where wrap_content children got trimmed by the launcher.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Block 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/today_block1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F5F4FC"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/today_block1_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#B8B4C8"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <!-- "NOW" badge, hidden unless the current block is live -->
        <TextView
            android:id="@+id/today_now_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginStart="8dp"
            android:text="NOW"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="#292E60"
            android:background="@drawable/widget_now_badge"
            android:includeFontPadding="false"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#33FFFFFF"/>

    <!-- Block 2 -->
    <LinearLayout
        android:id="@+id/today_block2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/today_block2_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#E4E1F0"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"/>

        <TextView
            android:id="@+id/today_block2_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="#8E88A6"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- Progress bar and summary -->
    <LinearLayout
        android:id="@+id/today_progress_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom">

        <ProgressBar
            android:id="@+id/today_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:progressDrawable="@drawable/widget_progress"
            android:min="0"
            android:max="100"
            android:progress="0"/>

        <TextView
            android:id="@+id/today_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="#B8B4C8"
            android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>
