<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept intentionally minimal after "Can't load widget" on MIUI. Only the
  narrow subset of views RemoteViews always accepts: LinearLayout, TextView,
  View. No ProgressBar (drawable references and framework styles are the
  common inflate-fail culprits), no nested weight layouts, no ?android:attr
  references. Progress is drawn as two coloured Views with dynamic widths set
  from code in TodayWidget.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/today_block1_subject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textColor="#B8B4C8"
        android:includeFontPadding="false"
        android:text=""/>

    <TextView
        android:id="@+id/today_block1_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#F5F4FC"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/today_block1_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="#B8B4C8"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:text=""/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#33FFFFFF"/>

    <TextView
        android:id="@+id/today_block2_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#E4E1F0"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/today_block2_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#8E88A6"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:text=""/>

    <!-- Progress rendered as text. A visual bar needs either a ProgressBar
         (drawable references fail on stripped-down inflaters) or a runtime
         width change on a View (RemoteViews only offers that from API 31).
         Text works on everything and is at least as informative. -->
    <TextView
        android:id="@+id/today_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textColor="#FAB074"
        android:includeFontPadding="false"
        android:text=""/>
</LinearLayout>
