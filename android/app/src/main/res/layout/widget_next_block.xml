<?xml version="1.0" encoding="utf-8"?>
<!--
  Restrained by design: two lines of copy over a solid tile. Widgets have a
  narrow palette of allowed views, so this stays inside the safe subset.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_subject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="#B8B4C8"
        android:textStyle="bold"
        android:text=""/>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#F5F4FC"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Prahar"/>

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:textColor="#B8B4C8"
        android:text=""/>
</LinearLayout>
